{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/sw.js",
      "dest": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/workbox-(.*)\\.js",
      "dest": "/workbox-$1.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/classic/sw.js",
      "dest": "/classic/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/pack/i/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/pack/manifest\\.json",
      "headers": {
        "Cache-Control": "no-cache",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/pack/(.*)",
      "status": 404
    },
    {
      "src": "/classic/(.*)",
      "dest": "/classic/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
