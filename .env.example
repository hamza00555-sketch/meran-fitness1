# ── Art pack ──────────────────────────────────────────────────
# Copy to .env (gitignored) and fill in.
#
# Nothing here is needed to publish the pack. `npm run build`
# (scripts/build.mjs) builds it from assets-cut into dist/pack, the site
# serves it at /pack/, and both designs read /pack/manifest.json — so
# every push to main publishes it, with no keys.

# Optional. Points BOTH designs at another manifest. For a build, set it
# in the environment (Vercel → Settings → Environment Variables), where
# scripts/build.mjs hands it to both builds; left unset, the build uses
# the self-hosted /pack/manifest.json. In .env it only steers
# `npm run dev`, which has no pack of its own — a deployed one works:
# VITE_ASSETS_MANIFEST_URL=https://meran-fitness1.vercel.app/pack/manifest.json

# ── Optional: the R2 bucket ───────────────────────────────────
# The pack used to be published to Cloudflare R2 by
# scripts/upload-r2.mjs; the app no longer needs it. Only to publish
# there anyway (then point VITE_ASSETS_MANIFEST_URL at the bucket).
# Cloudflare dashboard → R2 → Manage API tokens → Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meran-assets

# Base URL a bucket manifest hands out (build-manifest --base). The
# self-hosted pack uses /pack/ and needs nothing here.
ASSETS_BASE_URL=https://pub-189be0412bdd4092aa44be319badfd91.r2.dev/

# ── Miswadah — the design system's home ───────────────────────
# The project key from the Miswadah dashboard. Anyone holding it can read
# and replace the design system, so it lives here and never in the repo.
# Used only by scripts/push-design-system.mjs.
MISWADAH_TOKEN=ms_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
