# ── Art pack ──────────────────────────────────────────────────
# Copy to .env (gitignored) and fill in.

# Only needed to point at a different bucket — the live one is the
# default in src/assets/pack.js, so a plain build already works.
VITE_ASSETS_MANIFEST_URL=https://pub-189be0412bdd4092aa44be319badfd91.r2.dev/manifest.json

# Publishing credentials — scripts/upload-r2.mjs only, never shipped.
# Cloudflare dashboard → R2 → Manage API tokens → Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meran-assets

# Base URL the manifest hands out. r2.dev is rate-limited and Cloudflare
# calls it a development URL; move to a custom domain when there is one.
# Moving is cheap: rebuild with the new --base and republish.
ASSETS_BASE_URL=https://pub-189be0412bdd4092aa44be319badfd91.r2.dev/
