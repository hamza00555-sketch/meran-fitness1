# ── Icon pack ─────────────────────────────────────────────────
# Copy to .env (gitignored) and fill in.

# Where the app looks for the pack manifest at runtime.
# Also set this in the Vercel project's environment variables.
VITE_ASSETS_MANIFEST_URL=https://assets.meran.app/manifest.json

# Publishing credentials — scripts/upload-r2.mjs only, never shipped.
# Cloudflare dashboard → R2 → Manage API tokens → Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meran-assets

# Base URL the manifest hands out. Must be the bucket's CUSTOM domain,
# not the *.r2.dev one — that is rate-limited and not for production.
ASSETS_BASE_URL=https://assets.meran.app/
